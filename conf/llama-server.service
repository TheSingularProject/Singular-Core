[Unit]
Description=Singular Core AI Inference Engine (llama.cpp)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/singular
ExecStart=/opt/singular/bin/llama-server --host 0.0.0.0 --port 8080 -m /var/lib/singular/models/default.gguf -c 2048
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
